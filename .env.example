# =============================================================================
# chatailscale — configuração. Copie para .env e preencha (o install.sh faz
# isso com você). O .env NUNCA vai para o git (está no .gitignore).
# =============================================================================

# ---- Obrigatório: sua GPU no Modal (Kimi K3) ----
# Se a chave já circulou em texto claro (chat, ticket), rotacione no painel
# do Modal antes de usar.
MODAL_API_KEY=
OPENAI_API_BASE_URL=https://danniellau--ep-kimi-k3-btv-server.us-west.modal.direct/v1

# ---- Opcional ----
WEBUI_PORT=8080
WEBUI_NAME=Chat Privado

# Preenchido automaticamente pelo install.sh:
#  - http://btv-ollama:11434  (reutiliza o Ollama que já existe na VPS)
#  - http://ollama:11434      (Ollama dedicado deste stack)
OLLAMA_BASE_URL=
